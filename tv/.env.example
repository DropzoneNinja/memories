# Copy to .env for local dev (`npm run dev`). Not secret (just an address)
# — baked into the build at build time (main.ts), so a Tizen build/deploy
# always points at whichever server this file names. Normally you don't
# hand-edit this for a real TV deploy: `npm run deploy [tvIp] <serverUrl>`
# (tv/scripts/deploy.cjs) writes it for you and remembers it for every
# later deploy that doesn't pass a new one.
VITE_MEMORIES_API_URL=http://localhost:4000
