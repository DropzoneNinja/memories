// Initial data model — see PROJECT.md §7 (Persistence) and §6 (Responsibility
// Split). Expect this to grow as Phases 2-7 land; nothing here is final.

generator client {
  provider = "prisma-client-js"
  // "native" resolves correctly wherever `prisma generate` actually runs
  // (macOS locally, Debian-slim inside the API's Docker build stage) — no
  // extra target needed since the Docker image isn't musl-based (see
  // api/Dockerfile; Alpine's musl libc has a real getaddrinfo/DNS bug
  // that broke outbound fetch() to the Immich server, found in Phase 2).
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlaybackMode {
  SEQUENTIAL
  SHUFFLE
}

enum MatMode {
  AUTOMATIC
  NEUTRAL
  WARM
  COOL
  DARK
  LIGHT
  COMPLEMENTARY
  ANALOGOUS
  // Fixed neutrals (§5.3: "plus fixed neutrals — white, black, walnut/
  // wood") — unlike every mode above, these ignore the photo's dominant
  // colour entirely and always render the same swatch. WOOD/CORK/COTTON
  // additionally render with a real material texture layered under the
  // usual vignette (colour/matMode.ts's fixed OKLCH values are still the
  // base tone/fallback — see the `texture` field on the wire, added
  // alongside `colour` in playlist/presentation.ts) rather than a
  // perfectly flat colour, per the RAW/matt-example-3.png reference.
  WHITE
  BLACK
  WOOD
  CORK
  COTTON
}

enum DisconnectedBehavior {
  CONTINUE_QUEUE
  REPEAT_QUEUE
  FREEZE
}

// Video playback mode (post-Phase-8 addition — video was originally out of
// scope, see PROJECT.md §10/§14): a TV displays either its album's photos
// (existing behaviour) or its album's videos, never both at once.
enum DisplayMode {
  IMAGES
  VIDEO
}

enum CommandType {
  NEXT
  PREVIOUS
  PAUSE
  RESUME
}

enum CommandStatus {
  PENDING
  DELIVERED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  isAdmin      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  permissions  TvPermission[]
  auditLogs    AuditLog[]
  // True from account creation (routes/admin.ts's "register new user") or
  // an admin-triggered reset until the user actually calls
  // `PUT /me/password` themselves — a temp password is a lower-security
  // shared secret (generated, displayed once to the admin, handed off
  // out-of-band) and shouldn't stay valid for continued use. Enforced by
  // requirePasswordCurrent (auth/middleware.ts), which blocks every other
  // dashboard route while this is true.
  mustChangePassword Boolean @default(false)
  // Per-user Immich credential: each household member connects
  // their own Immich API key from Memories Web so they see their own
  // albums, rather than one shared key from .env. AES-256-GCM ciphertext
  // (api/src/immich/crypto.ts), keyed by ENCRYPTION_KEY — never the
  // plaintext key, never returned by any API response. The Immich server
  // address itself (IMMICH_BASE_URL) stays a shared, env-configured
  // setting — it's the same one self-hosted instance for the whole
  // household, only the identity/API key differs per user.
  immichApiKeyEncrypted String?
  // Last 4 characters of the plaintext key, stored alongside the
  // ciphertext purely so the UI can show "connected, ending in ••1234"
  // without ever decrypting just to render a status line.
  immichKeyLast4         String?
  ownedConfigurations     Configuration[]
}

model Tv {
  id                   String          @id @default(cuid())
  deviceId             String          @unique
  // Nullable until pairing completes — the Tv row is created at the
  // *request*-pairing step (§5.9), before a human has named it.
  name                 String?
  pairingCode          String?         @unique
  pairingCodeExpiresAt DateTime?
  pairedAt             DateTime?
  lastSeenAt           DateTime?
  // Cursor into that TV's materialized QueueItems (ordered by
  // `position`), so /playlist can hand out the next batch and loop the
  // album once exhausted. Reset to 0 whenever the queue is regenerated.
  lastServedPosition   Int             @default(0)
  // What the TV last reported actually displaying — distinct from
  // `lastServedPosition` (a hand-out cursor into batched /playlist
  // requests, which runs ahead of what's actually on screen). Reported
  // by the TV alongside its regular heartbeat (§5.10, extended in Phase
  // 6 so Memories Web can show "currently displaying" + EXIF, per §4.2).
  // Nullable: unset before the TV's first heartbeat with status.
  currentPresentationId String?
  paused               Boolean         @default(false)
  createdAt            DateTime        @default(now())
  configurations       Configuration[]
  queueItems           QueueItem[]
  commands             Command[]
  permissions          TvPermission[]
  auditLogs            AuditLog[]
}

model TvPermission {
  id     String @id @default(cuid())
  tv     Tv     @relation(fields: [tvId], references: [id], onDelete: Cascade)
  tvId   String
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([tvId, userId])
}

// Local cache of Immich album metadata for the album picker — asset content
// itself always comes from Immich on demand, never mirrored here.
model Album {
  id            String    @id @default(cuid())
  immichAlbumId String    @unique
  name          String
  assetCount    Int       @default(0)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
}

// Per-Immich-asset colour analysis cache (§5.3: "cache colour-analysis
// results by asset ID/hash — never re-analyse the same image twice").
// Keyed by the Immich asset id, shared across every TV/album/composition
// that happens to include that asset — the expensive step (decoding the
// image and clustering its pixels) only ever runs once per asset, ever.
// Stores OKLCH, not a derived hex, so it stays the source of truth for
// any future colour maths without lossy round-tripping through a string.
model AssetColourAnalysis {
  id            String   @id @default(cuid())
  immichAssetId String   @unique
  lightness     Float
  chroma        Float
  hue           Float
  analyzedAt    DateTime @default(now())
}

// One row per config change, versioned per TV (§5.10). The highest `version`
// for a given `tvId` is the active configuration.
model Configuration {
  id                   String               @id @default(cuid())
  tv                   Tv                   @relation(fields: [tvId], references: [id], onDelete: Cascade)
  tvId                 String
  version              Int
  albumIds             String[]
  intervalSeconds      Int                  @default(600)
  playbackMode         PlaybackMode         @default(SHUFFLE)
  matMode              MatMode              @default(AUTOMATIC)
  // VIDEO mode plays the same selected album's video assets instead of its
  // photos (queue.ts's buildVideoQueueRows) — `loop` only has an effect in
  // VIDEO mode: true replays the current video indefinitely, false advances
  // through the album's videos in order, wrapping after the last one.
  displayMode          DisplayMode          @default(IMAGES)
  loop                 Boolean              @default(false)
  disconnectedBehavior DisconnectedBehavior @default(CONTINUE_QUEUE)
  cacheSize            Int                  @default(8)
  // Collage layout (§5.2 addendum): every `collageFrequency`th composition
  // is a grid of up to `maxCollageImages` photos (any orientation) instead
  // of the normal single/portrait-group layout. 0 = disabled.
  maxCollageImages     Int                  @default(6)
  collageFrequency     Int                  @default(0)
  createdAt            DateTime             @default(now())
  // Whose Immich account backs this config version — set to whichever
  // user saved it (routes/tvs.ts's PUT .../config). Queue generation and
  // the TV-facing thumbnail proxy both resolve Immich credentials through
  // this, not the logged-in dashboard viewer, since the TV itself has no
  // login concept and fetches thumbnails long after whoever configured it
  // has logged out. SetNull rather than Cascade: if that user's account is
  // ever removed, old Configuration rows (and the audit trail of what was
  // configured) should survive — they just stop being able to regenerate
  // the queue until someone else reconfigures the TV.
  immichOwner          User?                @relation(fields: [immichOwnerId], references: [id], onDelete: SetNull)
  immichOwnerId        String?

  @@unique([tvId, version])
}

// A generated Presentation (§5.1) queued for a TV.
model QueueItem {
  id              String      @id @default(cuid())
  tv              Tv          @relation(fields: [tvId], references: [id], onDelete: Cascade)
  tvId            String
  position        Int
  presentationId  String      @unique
  layout          Json
  background      Json
  frame           Json
  transition      Json
  assets          Json
  durationSeconds Int
  // Baked into the row (not looked up from Configuration at read time)
  // because queueItemToPresentation() reconstructs the wire Presentation
  // from a single row with no Configuration join at two of its three call
  // sites (/playlist, getUpcomingPreview) — same reasoning as every other
  // per-row Presentation field (e.g. the mat colour).
  displayMode     DisplayMode @default(IMAGES)
  loop            Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@index([tvId, position])
}

model Command {
  id          String        @id @default(cuid())
  tv          Tv            @relation(fields: [tvId], references: [id], onDelete: Cascade)
  tvId        String
  type        CommandType
  status      CommandStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  deliveredAt DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  // SetNull, not Cascade: deleting a TV (routes/tvs.ts's DELETE
  // endpoint) should still leave its audit history behind — an audit
  // log existing to record "this happened" and then vanishing along
  // with the thing it was about would defeat the point of an audit log.
  tv        Tv?      @relation(fields: [tvId], references: [id], onDelete: SetNull)
  tvId      String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())
}
