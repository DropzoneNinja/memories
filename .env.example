# Copy to .env and fill in real values. Never commit .env itself.

# --- Postgres ---
POSTGRES_USER=memories
POSTGRES_PASSWORD=changeme
POSTGRES_DB=memories

# --- Immich (Memories API only — the TV and Memories Web never see this) ---
# The server address is still shared/deployment-level config — it's the
# same one self-hosted Immich instance for the whole household. The API
# key is NOT set here: each Memories Web user connects their own Immich
# API key from the dashboard's Settings panel, stored encrypted in
# Postgres (see api/src/immich/crypto.ts and routes/settings.ts) so each
# person sees their own albums.
IMMICH_BASE_URL=https://immich.lab.internal

# --- Memories API ---
# Signs Memories Web's login session tokens (JWT) — must actually be
# changed to a real random value, not left as "changeme" (Phase 6).
SESSION_SECRET=changeme
# Encrypts each user's stored Immich API key at rest — must be 32 bytes
# of hex (64 hex characters). Generate with `openssl rand -hex 32` and
# never reuse SESSION_SECRET's value for this.
ENCRYPTION_KEY=
# Structured log verbosity (api/src/log.ts) — 'info' by default (queue
# regeneration, Immich retries/failures, pairing, config saves, Immich
# account connect/disconnect). Set to 'debug' for per-composition detail,
# or 'warn'/'error' for an even quieter production log.
LOG_LEVEL=info

# --- Memories Web (build-time; safe to expose, just points the dashboard at the API) ---
# Use whatever address the browser (not the TV) will reach the API on.
WEB_API_BASE_URL=http://localhost:4000
